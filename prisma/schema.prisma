  descripcion     String?   @db.VarChar(100)
  imagen          String?   @db.VarChar(Max)
  nombreUnidad    String?   @db.VarChar(100)
  nombreCategoria String?   @db.VarChar(100)
  stockActual     Int?
  stockMin        Int?
