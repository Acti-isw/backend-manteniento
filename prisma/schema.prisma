generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["COMUNES", "INVENTARIOMTTO", "RECURSOSHUMANOS", "VEHICULOS"]
}

model COMAlmacenes {
  idAlmacen           Int                 @id(map: "PK_Almacenes") @default(autoincrement())
  idTipoAlmacen       Int
  idProceso           Int
  idSucursal          Int                 @default(0, map: "DF_COMAlmacenes_idSucursal")
  NombreAlmacen       String              @db.VarChar(50)
  Descripcion         String              @db.Text
  ELIMINADO           Boolean             @default(false, map: "DF_COMAlmacenes_ELIMINADO")
  XDEFAULT            Boolean             @default(false, map: "DF_COMAlmacenes_XDEFAULT")
  DESISTEMA           Boolean             @default(false, map: "DF_COMAlmacenes_DESISTEMA")
  IDUSUARIO           String              @db.VarChar(10)
  FECHAHORACAMBIO     DateTime            @default(now(), map: "DF_COMAlmacenes_FECHAHORACAMBIO") @db.DateTime
  COMTiposDeAlmacenes COMTiposDeAlmacenes @relation(fields: [idTipoAlmacen], references: [idTipoAlmacen], onUpdate: NoAction, map: "FK_COMAlmacenes_COMTiposDeAlmacenes")

  @@schema("COMUNES")
}

