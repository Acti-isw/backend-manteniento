generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model AccionesStock {
  idAccion       Int              @id(map: "PK_idAccion") @default(autoincrement())
  nombre         String           @db.VarChar(100)
  createAT       DateTime?        @default(now(), map: "DF__AccionesS__creat__693CA210") @db.DateTime
  updateAT       DateTime?        @db.DateTime
  isDelete       Boolean?         @default(false, map: "DF__AccionesS__isDel__6A30C649")
  idUsuario      Int?
  Usuarios       Usuarios?        @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK__AccionesS__idUsu__4CA06362")
  HistorialStock HistorialStock[]
}

model Categoria {
  idCategoria Int       @id(map: "PK_idCategoria") @default(autoincrement())
  nombre      String    @db.VarChar(100)
  createAT    DateTime? @default(now(), map: "DF__Categoria__creat__534D60F1") @db.DateTime
  updateAT    DateTime? @db.DateTime
  isDelete    Boolean?  @default(false, map: "DF__Categoria__isDel__5441852A")
  idUsuario   Int
  Usuarios    Usuarios  @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK__Categoria__idUsu__46E78A0C")
  Item        Item[]
}

model Herramientas {
  idHerramientas            Int                         @id(map: "PK_idHerramientas") @default(autoincrement())
  idItem                    Int
  codigoItson               String                      @db.VarChar(50)
  disponible                Boolean                     @default(false, map: "DF__Herramien__dispo__74AE54BC")
  createAT                  DateTime?                   @default(now(), map: "DF__Herramien__creat__75A278F5") @db.DateTime
  updateAT                  DateTime?                   @db.DateTime
  isDelete                  Boolean?                    @default(false, map: "DF__Herramien__isDel__76969D2E")
  idUsuario                 Int
  Item                      Item                        @relation(fields: [idItem], references: [idItem], onUpdate: NoAction, map: "FK__Herramien__idIte__5070F446")
  Usuarios                  Usuarios                    @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK__Herramien__idUsu__5165187F")
  SalidaEntradaHerramientas SalidaEntradaHerramientas[]

  @@index([codigoItson], map: "IX_Herramientas_codigoItson")
  @@index([idItem], map: "IX_Herramientas_idItem")
}

model HistorialStock {
  idHistorialStock Int           @id(map: "PK_idHistorialStock") @default(autoincrement())
  stockAnterior    Int?
  stockNuevo       Int
  idItem           Int
  idAccion         Int
  idUsuario        Int
  fecha            DateTime      @default(now(), map: "DF__Historial__fecha__70DDC3D8") @db.DateTime
  motivo           String?       @db.VarChar(Max)
  idEmpleado       Int?
  AccionesStock    AccionesStock @relation(fields: [idAccion], references: [idAccion], onUpdate: NoAction, map: "FK__Historial__idAcc__4E88ABD4")
  Item             Item          @relation(fields: [idItem], references: [idItem], onUpdate: NoAction, map: "FK__Historial__idIte__4D94879B")
  Usuarios         Usuarios      @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK__Historial__idUsu__4F7CD00D")
}

model Inventario {
  idInventario Int       @id(map: "PK_idInventario") @default(autoincrement())
  idItem       Int
  stockActual  Int
  stockMin     Int
  stockMax     Int
  createAT     DateTime? @default(now(), map: "DF__Inventari__creat__6477ECF3") @db.DateTime
  updateAT     DateTime? @db.DateTime
  isDelete     Boolean?  @default(false, map: "DF__Inventari__isDel__656C112C")
  idUsuario    Int
  Item         Item      @relation(fields: [idItem], references: [idItem], onUpdate: NoAction, map: "FK__Inventari__idIte__4AB81AF0")
  Usuarios     Usuarios  @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK__Inventari__idUsu__4BAC3F29")

  @@index([idItem], map: "IX_Inventario_idItem")
}

model Item {
  idItem            Int                 @id(map: "PK_idItem") @default(autoincrement())
  nombre            String              @db.VarChar(100)
  descripcion       String?             @db.VarChar(100)
  imagen            String?             @db.VarChar(Max)
  idUnidad          Int
  idCategoria       Int
  createAT          DateTime?           @default(now(), map: "DF__Item__createAT__5EBF139D") @db.DateTime
  updateAT          DateTime?           @db.DateTime
  isDelete          Boolean?            @default(false, map: "DF__Item__isDelete__5FB337D6")
  idUsuario         Int
  Herramientas      Herramientas[]
  HistorialStock    HistorialStock[]
  Inventario        Inventario[]
  Categoria         Categoria           @relation(fields: [idCategoria], references: [idCategoria], onUpdate: NoAction, map: "FK__Item__idCategori__49C3F6B7")
  Unidades          Unidades            @relation(fields: [idUnidad], references: [idUnidad], onUpdate: NoAction, map: "FK__Item__idUnidad__48CFD27E")
  Usuarios          Usuarios            @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK_Item_Usuarios")
  SalidaEntradaItem SalidaEntradaItem[]

  @@index([idCategoria], map: "IX_Item_idCategoria")
  @@index([idUnidad], map: "IX_Item_idUnidad")
}

model SalidaEntradaHerramientas {
  idSalidaEntradaHerramientas Int          @id(map: "PK_idSalidaEntradaHerramientas") @default(autoincrement())
  idHerramientas              Int
  idEmpleado                  Int?
  motivo                      String?      @db.VarChar(Max)
  isSalida                    Boolean?
  createAT                    DateTime?    @default(now(), map: "DF__SalidaEnt__creat__7B5B524B") @db.DateTime
  idUsuario                   Int
  Herramientas                Herramientas @relation(fields: [idHerramientas], references: [idHerramientas], onUpdate: NoAction, map: "FK_SalidaEntradaHerramientas_Herramientas")
  Usuarios                    Usuarios     @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK__SalidaEnt__idUsu__534D60F1")

  @@index([idEmpleado], map: "IX_SalidaEntradaHerramientas_idEmpleado")
  @@index([idHerramientas], map: "IX_SalidaEntradaHerramientas_idHerramientas")
}

model Unidades {
  idUnidad  Int       @id(map: "PK_idUnidad") @default(autoincrement())
  nombre    String    @db.VarChar(100)
  createAT  DateTime? @default(now(), map: "DF__Unidades__create__5812160E") @db.DateTime
  updateAT  DateTime? @db.DateTime
  isDelete  Boolean?  @default(false, map: "DF__Unidades__isDele__59063A47")
  idUsuario Int
  Item      Item[]
  Usuarios  Usuarios  @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK__Unidades__idUsua__47DBAE45")
}

model Usuarios {
  idUsuario                 Int                         @id(map: "PK_idUsuarios") @default(autoincrement())
  nombreCompleto            String                      @db.VarChar(60)
  usuario                   String                      @db.VarChar(45)
  password                  String                      @db.VarChar(100)
  avatar                    String?                     @db.VarChar(Max)
  idRole                    Int
  createAT                  DateTime?                   @default(now(), map: "DF__Usuarios__create__4E88ABD4") @db.DateTime
  updateAT                  DateTime?                   @default(now(), map: "DF__Usuarios__update__4F7CD00D") @db.DateTime
  isDelete                  Boolean?                    @default(false, map: "DF__Usuarios__isDele__5070F446")
  AccionesStock             AccionesStock[]
  Categoria                 Categoria[]
  Herramientas              Herramientas[]
  HistorialStock            HistorialStock[]
  Inventario                Inventario[]
  Item                      Item[]
  RolePermisos              RolePermisos[]
  SalidaEntradaHerramientas SalidaEntradaHerramientas[]
  SalidaEntradaItem         SalidaEntradaItem[]
  SalidaEntradaStock        SalidaEntradaStock[]
  Unidades                  Unidades[]
  Role                      Role                        @relation(fields: [idRole], references: [idRole], onUpdate: NoAction, map: "FK_Usuarios_Role")
}

model Role {
  idRole       Int            @id(map: "PK_idRole") @default(autoincrement())
  nombre       String?        @db.VarChar(45)
  createAT     DateTime?      @default(now(), map: "DF__Role__createAT__3DE82FB7") @db.DateTime
  updateAT     DateTime?      @db.DateTime
  isDelete     Boolean?       @default(false, map: "DF__Role__isDelete__3EDC53F0")
  RolePermisos RolePermisos[]
  Usuarios     Usuarios[]
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B611FB94BF5") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
}

model SalidaEntradaItem {
  idSalidaEntradaItem  Int                @id(map: "PK_idSalidaEntradaItem") @default(autoincrement())
  idSalidaEntradaStock Int
  idItem               Int
  cantidad             Int
  createAT             DateTime?          @default(now(), map: "DF__SalidaEnt__creat__0D7A0286") @db.DateTime
  idUsuario            Int
  stockAnterior        Int?
  stockActual          Int?
  isSalida             Boolean
  Item                 Item               @relation(fields: [idItem], references: [idItem], onUpdate: NoAction, map: "FK_SalidaEntradaItem_Item")
  SalidaEntradaStock   SalidaEntradaStock @relation(fields: [idSalidaEntradaStock], references: [idSalidaEntradaStock], onUpdate: NoAction, map: "FK_SalidaEntradaItem_SalidaEntradaStock")
  Usuarios             Usuarios           @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK_SalidaEntradaItem_Usuarios")

  @@index([idItem], map: "IX_SalidaEntradaItem_idItem")
  @@index([idSalidaEntradaStock], map: "IX_SalidaEntradaItem_idSalidaEntradaStock")
}

model SalidaEntradaStock {
  idSalidaEntradaStock Int                 @id(map: "PK_idSalidaEntradaStock") @default(autoincrement())
  idEmpleado           Int?
  cantidad             Int
  motivo               String?             @db.VarChar(Max)
  isSalida             Boolean?
  createAT             DateTime?           @default(now(), map: "DF__SalidaEnt__creat__07C12930") @db.DateTime
  idUsuario            Int
  SalidaEntradaItem    SalidaEntradaItem[]
  Usuarios             Usuarios            @relation(fields: [idUsuario], references: [idUsuario], onUpdate: NoAction, map: "FK_SalidaEntradaStock_Usuarios")

  @@index([idEmpleado], map: "IX_SalidaEntradaIStock_idEmpleado")
  @@index([idSalidaEntradaStock], map: "IX_SalidaEntradaStock_idStock")
}

model Permisos {
  idPermisos   Int            @id(map: "PK_idPermisos") @default(autoincrement())
  nombre       String         @db.VarChar(50)
  path         String         @db.VarChar(50)
  createAT     DateTime?      @default(now(), map: "DF__Permisos__create__76619304") @db.DateTime
  updateAT     DateTime?      @db.DateTime
  isDelete     Boolean?       @default(false, map: "DF__Permisos__isDele__7755B73D")
  RolePermisos RolePermisos[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model RolePermisos {
  idRolePermiso Int       @id(map: "PK__RolePerm__8DF1C16D3FFE0484") @default(autoincrement())
  idRole        Int
  idPermisos    Int
  createAT      DateTime? @default(now(), map: "DF__RolePermi__creat__382F5661") @db.DateTime
  updateAT      DateTime? @db.DateTime
  isDelete      Boolean?  @default(false, map: "DF__RolePermi__isDel__39237A9A")
  idUsuario     Int?
  Permisos      Permisos  @relation(fields: [idPermisos], references: [idPermisos], onUpdate: NoAction, map: "FK_RolePermisos_Permisos")
  Role          Role      @relation(fields: [idRole], references: [idRole], onUpdate: NoAction, map: "FK_RolePermisos_Role")
  Usuarios      Usuarios? @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "FK_RolePermisos_Usuarios")
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view visHerramientas {
  idHerramientas Int     @id
  nombre         String  @db.VarChar(100)
  codigoItson    String  @db.VarChar(50)
  disponible     Boolean
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view visHistorialStock {
  idHistorialStock Int      @id
  idItem           Int?
  idAccion         Int?
  idEmpleado       Int?
  idUsuario        Int?
  stockAnterior    Int?
  stockNuevo       Int
  nombreItem       String?  @db.VarChar(100)
  nombreAccion     String?  @db.VarChar(100)
  nombreUsuario    String?  @db.VarChar(45)
  motivo           String?  @db.VarChar(Max)
  fecha            DateTime @db.DateTime
