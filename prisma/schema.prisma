view visSalidaEntradaStock {
  idSalidaEntradaStock Int       @id
  idEmpleado           Int?
  cantidad             Int
  motivo               String?   @db.VarChar(Max)
  isSalida             Boolean?
  createAT             DateTime? @db.DateTime
  idUsuario            Int
  usuario              String?   @db.VarChar(45)
}
